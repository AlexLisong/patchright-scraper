# npm run setup generates your local .env with a random API key.
API_KEY=replace-with-a-random-key-at-least-24-characters
HOST=127.0.0.1
PORT=8787
# false opens a dedicated browser; true is suitable for a background service.
HEADLESS=false
CONCURRENCY=1
MAX_QUEUE=8
TIMEOUT_MS=30000
CACHE_TTL_MS=300000
# Optional installed browser; omit to use Patchright's installed Chromium.
# BROWSER_CHANNEL=chrome
